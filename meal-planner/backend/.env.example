# Port the API server listens on
PORT=4000

# Google Gemini API key used to generate meal plans and parse free-text bot messages
GEMINI_API_KEY=

# Model used for both plan generation and message parsing
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:3000

# Default plan mode shown in the header, e.g. "Plan Solo" or "Plan Family"
PLAN_LABEL=Plan Solo

# Default grocery pacing shown in the header, e.g. "Fast" or "Relaxed"
PLAN_PACE=Fast
