# From the Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here

# From the Discord Developer Portal > your application > General Information
DISCORD_CLIENT_ID=your-application-client-id

# Optional: only needed if you register slash commands to a single test
# server for instant updates instead of globally (recommended while building)
DISCORD_GUILD_ID=your-test-server-id

# Base URL of the backend API (local: http://localhost:4000)
API_BASE_URL=http://localhost:4000

# Channel the bot listens to for free-text meal-planning chat, and where it
# posts defrost reminders / weekly grocery lists. Right-click a channel in
# Discord (Developer Mode on) and "Copy Channel ID".
MEAL_CHANNEL_ID=your-channel-id

# URL of the deployed website, included in the bot's "plan generated" reply
WEBSITE_URL=http://localhost:3000

# Local time (24h, "HH:mm") to check for tomorrow's defrost reminders, daily
DEFROST_CHECK_TIME=18:00

# Day (0=Sun..6=Sat) and time to auto-generate next week's plan + grocery list
GROCERY_DAY=6
GROCERY_TIME=17:00
