# Discord bot token (can be the same app as the meal-planner bot, or a separate one)
DISCORD_TOKEN=your-bot-token-here

# Google Gemini API key (used to read receipt images)
GEMINI_API_KEY=your-gemini-key-here

# Gemini model for reading receipts (vision-capable)
GEMINI_MODEL=gemini-3.6-flash

# Base URL of the meal-planner backend that owns the fridge database
API_BASE_URL=http://localhost:4000
